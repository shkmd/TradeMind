// ── Brokers ─────────────────────────────────────────────────────────────

model Broker {
  id            String  @id @default(cuid())
  code          String  @unique // ZERODHA, DHAN, UPSTOX, ANGEL_ONE, FYERS, GROWW, GENERIC_CSV
  name          String
  isImplemented Boolean @default(false)
  logoUrl       String?

  brokerAccounts BrokerAccount[]
}

enum BrokerAccountType {
  MANUAL_IMPORT
  API_CONNECTED
  MANUAL_ENTRY
}

model BrokerAccount {
  id               String            @id @default(cuid())
  userId           String
  brokerId         String
  nickname         String
  accountType      BrokerAccountType @default(MANUAL_IMPORT)
  externalClientId String? // masked client id, display-only, never a credential
  currency         String            @default("INR")
  startingCapital  Decimal?          @db.Decimal(18, 2)
  isManualOrAlgo   String            @default("MANUAL") // MANUAL | ALGO
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker      Broker             @relation(fields: [brokerId], references: [id])
  connections BrokerConnection[]
  importJobs  ImportJob[]
  orders      Order[]
  executions  Execution[]
  trades      Trade[]
  holdings    Holding[]

  @@index([userId])
}

enum BrokerConnectionType {
  CSV_IMPORT
  API_OAUTH
  MANUAL
}

/// Read-only broker connections only. No password/PIN/TOTP/MPIN is ever stored
/// here — accessTokenEncrypted/refreshTokenEncrypted/apiKeyEncrypted remain
/// null for CSV-based accounts. apiKeyEncrypted is only set for brokers with
/// no OAuth redirect (Angel One SmartAPI, Kotak Neo Trade API), where each
/// end-user brings their own personal developer API key generated from that
/// broker's own portal — distinct from Zerodha/Dhan/Upstox, whose API key +
/// secret belong to this app's own registered developer app and stay as
/// server-side env vars (see .env.example), not a per-connection value here.
model BrokerConnection {
  id                    String                @id @default(cuid())
  brokerAccountId       String
  connectionType        BrokerConnectionType  @default(CSV_IMPORT)
  status                String                @default("ACTIVE")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  apiKeyEncrypted       String?
  tokenExpiresAt        DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId])
}
