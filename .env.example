# ── Auth.js ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Optional Google OAuth login. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" only when the two values above are filled in (controls the
# client-side "Continue with Google" button; the server-side provider is
# already conditional on GOOGLE_CLIENT_ID/SECRET independently).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────
# Note: host port 5434 (not the default 5432) to avoid clashing with other local Postgres instances.
# Use 127.0.0.1 rather than localhost — on some Windows setups Node resolves
# "localhost" to ::1 first and Docker Desktop's port publishing doesn't answer there.
DATABASE_URL=postgresql://trademind:trademind_dev_pw@127.0.0.1:5434/trademind?schema=public

# ── Redis / BullMQ (queue is wired but not started this phase) ─────────────
# Note: host port 6381 (not the default 6379) to avoid clashing with other local Redis instances.
REDIS_URL=redis://127.0.0.1:6381

# ── S3-compatible object storage (MinIO locally) ────────────────────────
# Note: host ports 9010/9011 (not the default 9000/9001) to avoid clashing with other local MinIO instances.
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=trademind_minio
S3_SECRET_ACCESS_KEY=trademind_minio_dev_pw
S3_BUCKET_IMPORTS=trademind-imports
S3_FORCE_PATH_STYLE=true

# ── Live broker connections (CSV/XLSX import works without any of these) ──
# Each is independent — leave any/all blank to disable that broker's live
# connect button; its CSV import still works either way.

# Zerodha Kite Connect: requires your own PAID developer app at
# https://developers.kite.trade (separate from a regular trading account).
# Register redirect URL: {NEXTAUTH_URL}/api/broker-connect/zerodha/callback
KITE_API_KEY=
KITE_API_SECRET=

# Dhan: requires a free Dhan Partner API app (developers console on
# web.dhan.co). Register redirect URL: {NEXTAUTH_URL}/api/broker-connect/dhan/callback
DHAN_APP_ID=
DHAN_APP_SECRET=

# Upstox: requires a free, self-service developer app at
# account.upstox.com/developer/apps. Register redirect URL:
# {NEXTAUTH_URL}/api/broker-connect/upstox/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# Angel One SmartAPI: requires a free developer app at smartapi.angelone.in.
# IMPORTANT — SmartAPI has NO redirect login for trading; connecting an
# account means the user's password + TOTP are submitted directly to Angel
# One's API through this app (never stored — see angel-one/live/angel-connect.ts).
ANGEL_ONE_API_KEY=

# Kotak Neo: requires a free "Trade API" consumer key generated inside the
# Kotak Neo app (More -> Trade API -> Generate application). Like Angel One,
# there is NO redirect login — mobile number + TOTP + MPIN are submitted
# directly to Kotak's API (never stored — see kotak/live/kotak-connect.ts).
KOTAK_CONSUMER_KEY=

# ── Razorpay (test mode; unused until the Billing phase) ────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Encryption key for broker OAuth tokens (never store raw secrets) ────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
